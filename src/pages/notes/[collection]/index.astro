---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { COLLECTION_META, getNoteCollections, getNotesForCollection } from '@/lib/notes'

export async function getStaticPaths() {
  const collections = await getNoteCollections()
  return collections.map((collection) => ({ params: { collection } }))
}

const { collection } = Astro.params
const meta = COLLECTION_META[collection]
const notes = await getNotesForCollection(collection)
---

<Layout class="max-w-4xl">
  <PageHead slot="head" title={meta.name} />
  <Breadcrumbs
    items={[
      { label: 'Notes', href: '/notes', icon: 'lucide:notebook-text' },
      { label: meta.name, icon: 'lucide:book-open' },
    ]}
  />

  <div class="mb-2">
    <p class="text-muted-foreground text-sm">{meta.description}</p>
  </div>

  <ul class="flex flex-col gap-1.5">
    {
      notes.map((note, i) => (
        <li>
          <Link
            href={`/notes/${collection}/${note.slug}`}
            class="hover:bg-muted/50 flex items-baseline gap-3 rounded-md px-3 py-2 transition-colors"
          >
            <span class="text-muted-foreground w-6 shrink-0 text-right text-xs">{i + 1}</span>
            <span class="text-sm">{note.title}</span>
          </Link>
        </li>
      ))
    }
  </ul>
</Layout>
