---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import {
  COLLECTION_META,
  getNoteCollections,
  getNotesForCollection,
  processNote,
} from '@/lib/notes'

export async function getStaticPaths() {
  const collections = await getNoteCollections()
  const paths = await Promise.all(
    collections.map(async (collection) => {
      const notes = await getNotesForCollection(collection)
      return notes.map((note, index) => ({
        params: { collection, note: note.slug },
        props: { note, notes, index, collection },
      }))
    }),
  )
  return paths.flat()
}

const { note, notes, index, collection } = Astro.props
const meta = COLLECTION_META[collection]
const html = await processNote(note.path, collection)
const prev = index > 0 ? notes[index - 1] : null
const next = index < notes.length - 1 ? notes[index + 1] : null
---

<Layout class="max-w-4xl">
  <PageHead slot="head" title={`${note.title} — ${meta.name}`} />
  <Breadcrumbs
    items={[
      { label: 'Notes', href: '/notes', icon: 'lucide:notebook-text' },
      { label: meta.name, href: `/notes/${collection}`, icon: 'lucide:book-open' },
      { label: note.title, icon: 'lucide:file-text' },
    ]}
  />

  <article class="prose pb-12">
    <Fragment set:html={html} />
  </article>

  {
    (prev || next) && (
      <nav class="flex items-center justify-between border-t pt-6 pb-12 text-sm">
        <div class="flex-1">
          {prev && (
            <Link
              href={`/notes/${collection}/${prev.slug}`}
              class="text-muted-foreground hover:text-foreground flex items-center gap-2 transition-colors"
            >
              <span>←</span>
              <span class="line-clamp-1">{prev.title}</span>
            </Link>
          )}
        </div>
        <div class="flex-1 text-right">
          {next && (
            <Link
              href={`/notes/${collection}/${next.slug}`}
              class="text-muted-foreground hover:text-foreground flex items-center justify-end gap-2 transition-colors"
            >
              <span class="line-clamp-1">{next.title}</span>
              <span>→</span>
            </Link>
          )}
        </div>
      </nav>
    )
  }
</Layout>

<script>
  if (document.querySelector('.katex')) {
    if (!document.querySelector('link[href*="katex.min.css"]')) {
      const link = document.createElement('link')
      link.rel = 'stylesheet'
      link.href = 'https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css'
      document.head.appendChild(link)
    }
  }
</script>

<style>
  /* Callout styles */
  :global(.callout) {
    border-left: 3px solid var(--callout-accent, var(--primary));
    background-color: color-mix(in oklch, var(--callout-accent, var(--primary)) 8%, transparent);
    border-radius: 0.375rem;
    margin: 1.25rem 0;
    overflow: hidden;
  }

  :global(.callout-title) {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.5rem 0.875rem;
    color: var(--callout-accent, var(--primary));
    background-color: color-mix(in oklch, var(--callout-accent, var(--primary)) 12%, transparent);
  }

  :global(.callout-body) {
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
  }

  :global(.callout-body > *:first-child) {
    margin-top: 0;
  }

  :global(.callout-body > *:last-child) {
    margin-bottom: 0;
  }

  :global(.callout-body p) {
    margin-block: 0.25rem;
  }

  /* Images from notes */
  :global(.prose img) {
    border-radius: 0.375rem;
    display: block;
  }

  /* TikZJax rendered SVGs */
  :global(.prose svg[width]) {
    display: block;
    margin: 1.5rem auto;
  }
</style>
