---
import DiscordPresence from '@/components/DiscordPresence'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-5xl">
  <PageHead slot="head" title="Home" />
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    <section class="rounded-lg border sm:flex-1">
      <div class="flex flex-col space-y-1.5 p-6">
        <h3 class="text-3xl leading-none font-medium">nightxade</h3>
        <p class="text-muted-foreground text-sm">
        /ˈnaɪt.ʃeɪd/ &bull; <span class="font-medium">nightshade</span>
        </p>
      </div>
      <div class="p-6 pt-0">
        <p class="text-muted-foreground mb-2 text-base">
          hi! i'm nightxade, an undergraduate student at the University of California, Berkeley studying Electrical Engineering and Computer Sciences.
        </p>

        <p class="text-muted-foreground mb-2 text-base">
          i'm interested in all things computer science! in recent times, i've enjoyed learning about security, microarchitecture, ML systems, AI safety, and distributed systems. check out my reading page to see what i've been studying lately :)
        </p>

        <p class="text-muted-foreground mb-2 text-base">
          if you want to get in touch with me, send me an email or dm me on discord.
        </p>
      </div>
    </section>

    <section class="w-full rounded-lg border sm:w-56">
      <DiscordPresence client:load />
    </section>
  </div>
</Layout>
