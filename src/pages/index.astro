---
import { readingEntries } from '@/data/reading'
import { getAllPosts } from '@/lib/data-utils'
import DiscordPresence from '@/components/DiscordPresence'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'

const recentPosts = (await getAllPosts()).slice(0, 5)
const recentReading = [...readingEntries]
  .sort((a, b) => b.year - a.year || b.month - a.month)
  .slice(0, 5)

const MONTH_ABBR = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']

const CATEGORY_ICON: Record<string, string> = {
  book: 'lucide:book-open',
  paper: 'lucide:file-text',
  article: 'lucide:globe',
}
---

<Layout class="max-w-5xl">
  <PageHead slot="head" title="Home" />
  <div class="flex flex-col gap-4 sm:flex-row sm:items-stretch">
    <section class="bg-muted/30 rounded-lg border sm:flex-1">
      <div class="flex flex-col space-y-1.5 p-6">
        <h3 id="site-heading" class="w-fit text-4xl leading-none font-medium">nightxade</h3>
        <p class="text-muted-foreground text-sm">
        /ˈnaɪt.ʃeɪd/ &bull; <span class="font-medium">nightshade</span>
        </p>
      </div>
      <div class="p-6 pt-0">
        <p class="text-foreground mb-2 text-lg">
        hi! i'm <b>nightxade</b>. i like to read <em>a lot</em> about everything cool with computers. <br>i also do security research, study ML systems, play CTFs, and query Claude.
        </p>

        <p class="text-muted-foreground mb-2 text-sm">
        if you want to get in touch, <Link href="mailto:nightxade@nightxade.dev" class="text-foreground" underline>send me an email</Link> or add me on discord. learn more about who i am <Link href="/about" class="text-foreground" underline>here</Link>!
        </p>
      </div>
    </section>

    <section class="w-full bg-muted/30 rounded-lg border sm:w-72">
      <DiscordPresence client:load />
    </section>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <!-- Recent Posts -->
    <section class="flex flex-col bg-muted/30 rounded-lg border">
      <div class="flex items-center justify-between border-b px-4 py-3">
        <h2 class="text-sm font-medium">Recent Posts</h2>
        <div class="flex gap-3">
          <Link href="/blog" class="text-muted-foreground hover:text-foreground text-xs transition-colors">blog →</Link>
          <Link href="/writeups" class="text-muted-foreground hover:text-foreground text-xs transition-colors">writeups →</Link>
        </div>
      </div>
      <ul class="flex flex-col divide-y">
        {recentPosts.map((post) => (
          <li>
            <Link
              href={`/${post.collection}/${post.id}`}
              class="group flex items-center gap-3 px-4 py-2.5"
            >
              <span class="text-muted-foreground shrink-0 text-xs tabular-nums">
                {post.data.date.toLocaleDateString('en-US', { month: 'short', year: '2-digit' })}
              </span>
              <span class="group-hover:text-foreground text-foreground/80 truncate text-sm transition-colors">
                {post.data.title}
              </span>
            </Link>
          </li>
        ))}
      </ul>
    </section>

    <!-- Recent Reading -->
    <section class="flex flex-col bg-muted/30 rounded-lg border">
      <div class="flex items-center justify-between border-b px-4 py-3">
        <h2 class="text-sm font-medium">Recent Reading</h2>
        <Link href="/reading" class="text-muted-foreground hover:text-foreground text-xs transition-colors">see all →</Link>
      </div>
      <ul class="flex flex-col divide-y">
        {recentReading.map((entry) => (
          <li>
            {entry.url ? (
              <a
                href={entry.url}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-3 px-4 py-2.5"
              >
                <Icon name={CATEGORY_ICON[entry.category]} class="text-muted-foreground size-3.5 shrink-0" />
                <span class="group-hover:text-foreground text-foreground/80 truncate text-sm transition-colors">
                  {entry.title}
                </span>
                <span class="text-muted-foreground ml-auto shrink-0 text-xs tabular-nums">
                  {MONTH_ABBR[entry.month]} '{String(entry.year).slice(2)}
                </span>
              </a>
            ) : (
              <div class="flex items-center gap-3 px-4 py-2.5">
                <Icon name={CATEGORY_ICON[entry.category]} class="text-muted-foreground size-3.5 shrink-0" />
                <span class="text-foreground/80 truncate text-sm">{entry.title}</span>
                <span class="text-muted-foreground ml-auto shrink-0 text-xs tabular-nums">
                  {MONTH_ABBR[entry.month]} '{String(entry.year).slice(2)}
                </span>
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>

<style>
  #site-heading {
    background: linear-gradient(to right, #9295c8, #484c84, #9295c8);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  [data-theme='dark'] #site-heading {
    background: linear-gradient(to right, #c5c8ee, #6b6fa8, #c5c8ee);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @keyframes gradient-flow {
    0%   { background-position: 0% center; }
    100% { background-position: 200% center; }
  }

  #site-heading:hover {
    animation: gradient-flow 3s linear infinite;
  }
</style>
