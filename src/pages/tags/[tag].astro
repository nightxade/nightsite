---
import BlogCard from '@/components/blog-card.astro'
import WriteupCard from '@/components/writeup-card.astro'
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'
import Link from '@/components/link.astro'
import { SITE } from '@/consts'
import { getAllTags, getPostsByTag, getWriteupsByTag } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const tagMap = await getAllTags()
  return Array.from(tagMap.keys()).map((tag) => ({ params: { tag } }))
}

const { tag } = Astro.params

const [allTaggedPosts, writeupGroups] = await Promise.all([
  getPostsByTag(tag),
  getWriteupsByTag(tag),
])
const blogPosts = allTaggedPosts.filter((p) => p.collection === 'blog') as CollectionEntry<'blog'>[]

type GroupItem = { kind: 'writeup'; parent: CollectionEntry<'writeups'>; subposts: CollectionEntry<'writeups'>[] }
type BlogItem = { kind: 'blog'; post: CollectionEntry<'blog'> }
type PageItem = GroupItem | BlogItem

const allItems: PageItem[] = [
  ...writeupGroups.map((g) => ({ kind: 'writeup' as const, ...g })),
  ...blogPosts.map((p) => ({ kind: 'blog' as const, post: p })),
]

const postsPerPage = SITE.postsPerPage
---

<Layout class="max-w-5xl">
  <PageHead
    slot="head"
    title={`Posts tagged with "${tag}"`}
    description={`A collection of posts tagged with ${tag}.`}
    noindex
  />
  <Breadcrumbs
    items={[
      { href: '/tags', label: 'Tags', icon: 'lucide:tags' },
      { label: tag, icon: 'lucide:tag' },
    ]}
  />

  <ul id="items-list" class="flex flex-col gap-y-4">
    {allItems.map((item) =>
      item.kind === 'writeup' ? (
        <li data-item class="flex flex-col gap-y-2">
          <WriteupCard entry={item.parent} />
          <ul class="border-border ml-4 flex flex-col gap-y-1 border-l pl-4">
            {item.subposts.map((sub) => (
              <li>
                <Link
                  href={`/writeups/${sub.id}`}
                  class="text-muted-foreground hover:text-foreground flex items-center gap-x-2 text-sm transition-colors"
                >
                  <Icon name="lucide:file-text" class="size-3.5 shrink-0" />
                  {sub.data.title}
                </Link>
              </li>
            ))}
          </ul>
        </li>
      ) : (
        <li data-item class="flex flex-col gap-y-2">
          <BlogCard entry={item.post} />
        </li>
      )
    )}
  </ul>

  <nav class="mx-auto mt-10 flex w-full justify-center" aria-label="pagination">
    <ul id="pagination-list" class="flex flex-row flex-wrap items-center gap-1"></ul>
  </nav>
</Layout>

<script define:vars={{ postsPerPage }}>
  const CHEVRON_LEFT = `<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>`
  const CHEVRON_RIGHT = `<svg xmlns="http://www.w3.org/2000/svg" class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>`
  const BTN_BASE = 'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-md text-sm font-medium transition-all disabled:pointer-events-none disabled:opacity-50 outline-none cursor-pointer'
  const BTN_GHOST_ICON = `${BTN_BASE} hover:bg-muted hover:text-foreground size-9`
  const BTN_OUTLINE_ICON = `${BTN_BASE} border bg-background hover:bg-muted hover:text-foreground size-9`
  const BTN_GHOST_DEFAULT = `${BTN_BASE} hover:bg-muted hover:text-foreground h-9 gap-1 px-2.5`

  const items = Array.from(document.querySelectorAll('[data-item]'))
  const paginationList = document.getElementById('pagination-list')
  let currentPage = 1

  function totalPages() {
    return Math.max(1, Math.ceil(items.length / postsPerPage))
  }

  function pagesToShow(current, total) {
    if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1)
    const set = new Set([1, total])
    for (let i = Math.max(1, current - 1); i <= Math.min(total, current + 1); i++) set.add(i)
    const sorted = Array.from(set).sort((a, b) => a - b)
    const result = []
    let prev = 0
    for (const p of sorted) {
      if (p - prev > 1) result.push(null)
      result.push(p)
      prev = p
    }
    return result
  }

  function goToPage(page) {
    currentPage = page
    render()
    document.getElementById('items-list').scrollIntoView({ behavior: 'smooth', block: 'start' })
  }

  function renderPagination(current, total) {
    paginationList.innerHTML = ''
    if (total <= 1) return

    const li = (inner) => {
      const el = document.createElement('li')
      el.appendChild(inner)
      return el
    }

    const prev = document.createElement('button')
    prev.className = BTN_GHOST_DEFAULT
    prev.innerHTML = `${CHEVRON_LEFT}<span class="hidden sm:block">Previous</span>`
    if (current === 1) prev.disabled = true
    else prev.addEventListener('click', () => goToPage(current - 1))
    paginationList.appendChild(li(prev))

    for (const p of pagesToShow(current, total)) {
      if (p === null) {
        const ellipsis = document.createElement('span')
        ellipsis.className = 'flex size-9 items-center justify-center text-sm'
        ellipsis.textContent = '···'
        paginationList.appendChild(li(ellipsis))
      } else {
        const btn = document.createElement('button')
        btn.className = p === current ? BTN_OUTLINE_ICON : BTN_GHOST_ICON
        btn.textContent = String(p)
        if (p !== current) btn.addEventListener('click', () => goToPage(p))
        paginationList.appendChild(li(btn))
      }
    }

    const next = document.createElement('button')
    next.className = BTN_GHOST_DEFAULT
    next.innerHTML = `<span class="hidden sm:block">Next</span>${CHEVRON_RIGHT}`
    if (current === total) next.disabled = true
    else next.addEventListener('click', () => goToPage(current + 1))
    paginationList.appendChild(li(next))
  }

  function render() {
    const total = totalPages()
    const start = (currentPage - 1) * postsPerPage
    items.forEach((item, i) => {
      item.classList.toggle('hidden', i < start || i >= start + postsPerPage)
    })
    renderPagination(currentPage, total)
  }

  render()
</script>
