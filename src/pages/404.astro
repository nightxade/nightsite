---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/layout.astro'
import { cn } from '@/lib/utils'
---

<Layout class="max-w-5xl">
  <PageHead slot="head" title="404" />
  <Breadcrumbs items={[{ label: '???', icon: 'lucide:circle-help' }]} />

  <section
    class="flex flex-col items-center justify-center gap-y-4 text-center"
  >
    <div class="max-w-lg">
      <h1 class="mb-4 text-3xl font-medium">404: Page not found</h1>
      <p class="prose">Unfortunately, you somehow stumbled upon a null deref on the site :&lt;</p>
      <br>
      <pre class="command-line text-left"><code class="language-bash">Program received signal SIGSEGV, Segmentation fault.</code>
<code class="language-bash"><span style="color: #6495ED">0x0000006e69676874</span> in <span style="color: yellow">main</span> ()</code>
<code class="language-bash" style="color:red">pwndbg@night&gt; <span class="cursor">█</span></code></pre>

<style>
  .cursor {
    animation: blink 2s step-start infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
    </div>
    <Link
      href="/"
      class={cn(buttonVariants({ variant: 'outline' }), 'flex gap-x-1.5 group')}
    >
      <span class="transition-transform group-hover:-translate-x-1">&larr;</span
      > Go to home page
    </Link>
  </section>
</Layout>
