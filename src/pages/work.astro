---
import Breadcrumbs from '@/components/breadcrumbs.astro'
import PageHead from '@/components/page-head.astro'
import WorkCard from '@/components/work-card.astro'
import Layout from '@/layouts/layout.astro'
import { getAllWork } from '@/lib/data-utils'

const work = await getAllWork()
---

<Layout class="max-w-5xl">
  <PageHead slot="head" title="Work" />
  <Breadcrumbs items={[{ label: 'Work', icon: 'lucide:briefcase' }]} />

  <section>
    <div class="flex flex-col gap-4">
      {work.map((entry) => <WorkCard entry={entry} />)}
    </div>
  </section>
</Layout>
